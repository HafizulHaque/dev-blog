---
layout: layouts/base.njk
---
<article>
  <header class="article-header">
    <h1>{{ title }}</h1>
    <p class="article-description">{{ description }}</p>
    <time datetime="{{ date | date('yyyy-MM-dd') }}">{{ date | date('MMMM d, yyyy') }}</time>
  </header>

  <div class="article-content">
    {{ content | safe }}
  </div>
</article>
