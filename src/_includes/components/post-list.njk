<ul class="post-list">
  {% for post in posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date('MMM d, yyyy') }}</time>
    <p>{{ post.data.description }}</p>
  </li>
  {% else %}
  <li>No articles yet.</li>
  {% endfor %}
</ul>
